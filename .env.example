# Artifacts Configuration
# Directory for all persistent data (inputs, bronze, silver, cache)
# Default: "artifacts" (relative to project root)
# Production: Can be absolute path to external storage (e.g., /mnt/data/artifacts)
ARTIFACTS_PATH=artifacts

# OpenAI/OpenRouter Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o

# Feature Flags
ENABLE_SUMMARIZATION=true

# Network Configuration
# Optional: HTTP/HTTPS/SOCKS5 proxy for all HTTP operations
# Examples: http://proxy:port, http://user:pass@proxy:port, socks5://proxy:port
HTTP_PROXY=

# Whisper Configuration (YouTube transcription)
# Model options: tiny, base, small, medium, large-v2, large-v3, large, distil-large-v2, distil-large-v3, large-v3-turbo
# Larger models = better quality but slower processing and more disk space
WHISPER_MODEL=large-v3
# Device: cpu (default), cuda (NVIDIA GPU), or mps (Mac M1/M2)
WHISPER_DEVICE=cpu
# Cache directory for downloaded Whisper models (persists across Docker restarts)
# Default: artifacts/cache/whisper_models
WHISPER_CACHE_DIR=artifacts/cache/whisper_models
